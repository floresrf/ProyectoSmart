<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  tools:context=".Fragmento3"
  android:background="#254445">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#254445"
    android:padding="20dp">

    <!-- Título Principal -->
    <TextView
      android:id="@+id/textView3"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="Visualización de Pacientes"
      android:textAlignment="center"
      android:textColor="@color/white"
      android:textSize="24sp"
      android:textStyle="bold"
      android:letterSpacing="0.03"
      android:layout_marginTop="8dp"
      android:layout_marginBottom="16dp" />

    <!-- Subtítulo -->
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="Pacientes asignados a su turno"
      android:textAlignment="center"
      android:textColor="#BFA067"
      android:textSize="14sp"
      android:textStyle="italic"
      android:layout_marginBottom="24dp" />

    <!-- RECYCLERVIEW DINÁMICO (Reemplaza al ScrollView estático) -->
    <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/rvPacientesTurno"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:scrollbars="vertical" />

    <!-- Botón Volver -->
    <com.google.android.material.button.MaterialButton
      android:id="@+id/btnRegresarMenu"
      android:layout_width="match_parent"
      android:layout_height="50dp"
      android:text="VOLVER AL MENÚ"
      android:textSize="15sp"
      android:textStyle="bold"
      android:textColor="@color/white"
      android:backgroundTint="#BFA067"
      android:layout_marginTop="16dp"
      app:cornerRadius="8dp" />

  </LinearLayout>

</FrameLayout>
